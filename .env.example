# Variables de entorno de Apolo — PLANTILLA. Sin valores reales.
#
# Copia este archivo a `.env.local` para desarrollo. `.env.local` está en
# .gitignore y NUNCA debe subirse al repositorio.
#
# En producción se configuran en Vercel:
#   Project → Settings → Environment Variables
#
# NINGUNA de estas lleva el prefijo NEXT_PUBLIC_ a propósito. Una variable
# NEXT_PUBLIC_ queda incrustada en el JavaScript que descarga cualquiera que
# abra la página: sería publicar el token.

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# Token del bot, de BotFather. Solo servidor.
# Quien lo tiene puede leer y escribir en TODOS los chats del bot, así que si se
# filtra hay que revocarlo con /revoke en BotFather, no rotarlo "por si acaso".
TELEGRAM_BOT_TOKEN=

# Chat por defecto cuando el informe no especifica destino.
# Para un grupo empieza por "-100". Se obtiene en /api/telegram/chats.
TELEGRAM_DEFAULT_CHAT_ID=

# Secreto del webhook, si más adelante el bot recibe comandos.
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Fase 2 — todavía no implementadas
# -----------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Traccar (seguimiento GPS)
TRACCAR_BASE_URL=
TRACCAR_API_TOKEN=
TRACCAR_WEBHOOK_SECRET=

# Optimización y rutas
VROOM_BASE_URL=
GRAPHHOPPER_BASE_URL=
GRAPHHOPPER_API_KEY=

# Mapas. Las teselas de OpenStreetMap del demo no admiten tráfico de
# producción: aquí va MapTiler, Protomaps o un servidor propio.
NEXT_PUBLIC_MAP_STYLE_URL=
