# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla SI se versiona: documenta que variables hacen falta, sin valores.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material de partida ajeno al producto.
# La regla irrevocable del proyecto es que el Blueprint Macedonia y todo lo
# relacionado con Sumigases/Sudematin/SumiControl NO existen dentro de Apolo,
# ni en el codigo ni en el repositorio. Un `git add -A` metio este .txt en un
# commit; queda ignorado para que no vuelva a pasar.
*Blueprint Macedonia*
/PROMPT*.txt

# Material de marca en bruto: el isotipo vive en SVG dentro del codigo.
/Apolo Logo.png

# Carpeta con el token del bot en claro. NUNCA se versiona.
/token_telegram/

# Herramienta local del agente, no código de Apolo.
# `settings.local.json` son permisos de ESTA máquina, y `skills/` son 3,4 MB de
# skills de terceros que se reinstalan con un comando. Ninguna de las dos cosas
# pertenece al historial del producto.
/.claude/settings.local.json
/.claude/skills/
